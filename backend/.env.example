PORT=5679

# Optional. SQLite 数据库文件位置（默认仓库根 data/huobao.sqlite3）
# SQLITE_PATH=/path/to/huobao.sqlite3

# Optional. 数据根目录（默认仓库根 data/；桌面版由 Electron 注入 HUOBAO_DATA_DIR）
# HUOBAO_DATA_DIR=/path/to/data
# STORAGE_PATH=/path/to/data/static

# Optional. MySQL → SQLite 启动自动迁移（老用户升级）：显式配置 DATABASE_URL 或
# MYSQL_HOST 且 SQLite 为空库时，启动自动一次性导入全部表（原子事务 + 行数校验 +
# 成功后写 .mysql-imported 标记）。关闭：MYSQL_AUTO_IMPORT=false
# DATABASE_URL=mysql://huobao:huobao@127.0.0.1:3306/huobao_drama

# Optional. Public base URL of this backend. Required when passing locally
# uploaded reference videos/audios/files to an upstream video API (local
# /static paths are resolved as PUBLIC_BASE_URL + path).
# PUBLIC_BASE_URL=https://your-domain.com

# Optional. Grok 兼容网关（OpenAI 风格）。两个都填上后，启动时自动写入
# 文本 / 图片 / 视频三条配置，不必再准备 OpenAI、火山、可灵等其它厂商密钥。
# GROK_API_BASE 是 GROK_BASE_URL 的别名。密钥只放 backend/.env（已 gitignore），不要提交。
# GROK_BASE_URL=https://codecc.cc
# GROK_API_KEY=
# 文本默认用非推理模型，避免多轮工具调用被思考链打断。可改成 grok-4.7 / grok-3-mini。
# GROK_TEXT_MODEL=grok-4.20-non-reasoning
# GROK_IMAGE_MODEL=grok-imagine-image
# GROK_VIDEO_MODEL=grok-imagine-video-1.5

# Optional. Grsai 只负责图片和视频，不覆盖上面的 Grok 文本配置。
# 两个都填上后，启动写入「Grsai 图片」(gpt-image-2.5) 和「Grsai 视频」(minimax-h3)，
# 第一次插入时优先级高于同类型已有配置。国内节点用 https://grsai.dakka.com.cn。
# 密钥不要提交到仓库。
# GRSAI_BASE_URL=https://grsaiapi.com
# GRSAI_API_KEY=
# GRSAI_IMAGE_MODEL=gpt-image-2.5
# GRSAI_VIDEO_MODEL=minimax-h3

# Optional. 关闭文本模型思考(thinking)模式,默认 true。
# 对 new-api 类中转站在请求体注入关思考参数,规避中转站强制回传
# reasoning_content 导致的 400;官方 OpenAI/Gemini 端点自动跳过。
# AI_DISABLE_THINKING=false
# 可选:自定义注入的 OpenAI 风格参数(JSON),适配不同中转站
# AI_THINKING_OFF_PATCH={"thinking":{"type":"disabled"},"enable_thinking":false}
