# Docker 部署环境变量（复制为 .env 后修改）
# Watchtower HTTP API 令牌，app 与 watchtower 两侧必须一致；生产环境务必修改
WATCHTOWER_TOKEN=please-change-me

# 构建镜像时注入的版本号（发布时指定，如 1.2.0；本地构建保持 dev 即可）
HUOBAO_VERSION=dev

# 可选。Grok 兼容网关。两个都填写后，容器启动会写入文本/图片/视频配置。
# 本地开发请写在 backend/.env，不要把真实密钥提交到仓库。
# GROK_BASE_URL=https://codecc.cc
# GROK_API_KEY=
# GROK_TEXT_MODEL=grok-4.20-non-reasoning
# GROK_IMAGE_MODEL=grok-imagine-image
# GROK_VIDEO_MODEL=grok-imagine-video-1.5
